# ===== 伺服器 =====
PORT=3000
# 對外的 https 網址（LINE webhook 與 LIFF 都需要 https）
PUBLIC_BASE_URL=https://your-domain.example.com

# ===== 店家資訊 =====
SHOP_NAME=我的小店
SHOP_ADDRESS=台北市信義區某某路 1 號
# 時區偏移（台灣固定 +08:00，無日光節約）
TIMEZONE_OFFSET=+08:00
TIMEZONE_NAME=Asia/Taipei
# 營業時段（可訂位時間），每段用逗號分隔
BOOKING_SLOTS=11:30,12:30,13:30,17:30,18:30,19:30
# 每次用餐時間（分鐘）
BOOKING_DURATION_MINUTES=90
# 每個時段最多接受幾組
MAX_BOOKINGS_PER_SLOT=5
# 最多可提前幾天訂位
MAX_DAYS_AHEAD=30

# ===== LINE Messaging API（官方帳號）=====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ===== LINE Login / LIFF（訂位表單）=====
LIFF_ID=
# LINE Login channel 的 Channel ID，用來驗證 LIFF 的 ID token
LINE_LOGIN_CHANNEL_ID=

# ===== Google 日曆 =====
# 店家要寫入的日曆 ID（日曆設定 → 整合日曆 → 日曆 ID）
GOOGLE_CALENDAR_ID=
# 服務帳戶 JSON 金鑰：擇一填寫（檔案路徑 或 整份 JSON 內容）
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== 提醒 =====
# 在訂位前多少分鐘透過 LINE 推播提醒顧客（可多個，逗號分隔）
LINE_REMINDER_MINUTES=1440,60
# 店家 Google 日曆事件的提醒（分鐘）
CALENDAR_POPUP_REMINDER_MINUTES=60
CALENDAR_EMAIL_REMINDER_MINUTES=1440
# 提醒排程每隔幾秒檢查一次
REMINDER_CHECK_INTERVAL_SECONDS=60
